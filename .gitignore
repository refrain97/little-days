# The public code repository uses an allowlist. Keep local journals, reviews,
# backups, test screenshots, credentials and the retired local API helpers out.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml
!/README.md
!/DEPLOY_GITHUB.md
!/index.html
!/package.json
!/server.mjs
!/scripts/
/scripts/*
!/scripts/build.mjs
!/src/
/src/*
!/src/*.js
!/src/*.css
!/public/
/public/*
!/public/sw.js
!/public/manifest.json
!/public/icons/
/public/icons/*
!/public/icons/apple-touch-icon.png
!/public/icons/flower.svg
!/public/icons/icon-192.png
!/public/icons/icon-512.png
!/public/images/
/public/images/*
!/public/images/breakfast.jpg
!/public/images/hero.jpg
!/public/images/iced-latte.jpg
!/public/images/idea-lemon-noodles.jpg
!/public/images/idea-tomato-noodles.jpg
!/public/images/noodles.jpg
!/public/images/tomato-eggs.jpg
!/public/images/venue-cafe.jpg
!/public/images/venue-noodles.jpg
!/public/images/walk.jpg
