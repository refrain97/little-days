# The public code repository uses an allowlist. Keep local journals, reviews,
# backups, test screenshots, credentials and the retired local API helpers out.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml
!/README.md
!/DEPLOY_GITHUB.md
!/index.html
!/package.json
!/package-lock.json
!/server.mjs
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/mobile-qa.mjs
!/scripts/standalone-qa.mjs
!/scripts/pwa-qa.mjs
!/scripts/cloud-qa.mjs
!/scripts/install-hooks.mjs
!/scripts/pre-push
!/tests/
/tests/*
!/tests/sync.test.mjs
!/tests/github-fixture.mjs
!/tests/quick-note.test.mjs
!/tests/private-backup.test.mjs
!/tests/storage-safety.test.mjs
!/src/
/src/*
!/src/*.js
!/src/*.css
!/public/
/public/*
!/public/sw.js
!/public/manifest.json
!/public/icons/
/public/icons/*
!/public/icons/apple-touch-icon.png
!/public/icons/flower.svg
!/public/icons/icon-192.png
!/public/icons/icon-512.png
!/public/images/
/public/images/*
!/public/images/breakfast.webp
!/public/images/hero.webp
!/public/images/iced-latte.webp
!/public/images/idea-lemon-noodles.webp
!/public/images/idea-tomato-noodles.webp
!/public/images/noodles.webp
!/public/images/tomato-eggs.webp
!/public/images/venue-cafe.webp
!/public/images/venue-noodles.webp
!/public/images/walk.webp
!/public/fonts/
/public/fonts/*
!/public/fonts/days-journal.woff2
!/public/fonts/days-breakfast.woff2
!/public/fonts/days-freetime.woff2
!/public/fonts/days-editor.woff2
!/public/fonts/OFL.txt
